#!/usr/bin/env bash
set -euo pipefail

VALID_TYPES=("feature" "fix" "refactor" "chore" "docs")
PROTECTED_BRANCHES=("main" "master" "develop")

usage() {
  echo "Usage: git-workflow-start <type> <branch-name>"
  echo "Types: ${VALID_TYPES[*]}"
  echo "Example: git-workflow-start fix cart-total"
  exit 1
}

sanitize_branch_name() {
  echo "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9-]/-/g' \
    | sed 's/--*/-/g' \
    | sed 's/^-//;s/-$//'
}

is_protected_branch() {
  local branch="$1"
  for p in "${PROTECTED_BRANCHES[@]}"; do
    [[ "$branch" == "$p" ]] && return 0
  done
  return 1
}

# --- Validate arguments ---
[[ $# -lt 2 ]] && usage

type="$1"
shift
raw_name="$*"

valid=false
for t in "${VALID_TYPES[@]}"; do
  [[ "$type" == "$t" ]] && valid=true && break
done
if [[ "$valid" == false ]]; then
  echo "Error: Invalid type '$type'"
  echo "Valid types: ${VALID_TYPES[*]}"
  exit 1
fi

branch_slug=$(sanitize_branch_name "$raw_name")
if [[ -z "$branch_slug" ]]; then
  echo "Error: Branch name is empty after sanitization"
  exit 1
fi

# --- Step 1: Ensure git repo ---
if ! git rev-parse --is-inside-work-tree &>/dev/null; then
  echo "[init] Not a git repository. Initializing..."
  git init
  # Ensure git identity exists for the initial commit
  if ! git config user.name &>/dev/null; then
    git config user.name "dev"
  fi
  if ! git config user.email &>/dev/null; then
    git config user.email "dev@local"
  fi
  git commit --allow-empty -m "chore: initial empty commit"
  echo "[init] Created git repo with empty initial commit."
fi

# --- Step 2: Handle uncommitted changes ---
if ! git diff --quiet HEAD 2>/dev/null || ! git diff --cached --quiet HEAD 2>/dev/null; then
  stash_msg="Auto-stash before task: ${type}-${branch_slug}"
  echo "[stash] Uncommitted changes detected. Stashing..."
  git stash push -m "$stash_msg"
  echo "[stash] Current stash stack:"
  git stash list
fi

# --- Step 3: Branch logic ---
current_branch=$(git branch --show-current 2>/dev/null || echo "")

if [[ -z "$current_branch" ]]; then
  # Detached HEAD or fresh repo with no commits beyond our init
  current_branch="(detached)"
fi

target_branch="${type}-${branch_slug}"

if is_protected_branch "$current_branch"; then
  # Check for branch name collision, append suffix if needed
  if git show-ref --verify --quiet "refs/heads/$target_branch"; then
    suffix=2
    while git show-ref --verify --quiet "refs/heads/${target_branch}-${suffix}"; do
      ((suffix++))
    done
    target_branch="${target_branch}-${suffix}"
    echo "[branch] '${type}-${branch_slug}' already exists. Using '$target_branch' instead."
  fi

  git checkout -b "$target_branch"
  echo "[branch] Created and switched to '$target_branch'"
else
  echo "[branch] Already on non-protected branch '$current_branch'. Continuing here."
  target_branch="$current_branch"
fi

# --- Summary ---
echo ""
echo "=== Git Workflow Ready ==="
echo "  Branch: $target_branch"
echo "  Type:   $type"
echo "========================="
