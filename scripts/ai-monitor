<script>
let _data = null;
let _active = null;

// ---------------------------------------------------------------------------
// Fetch data
// ---------------------------------------------------------------------------

async function fetchData() {
  const res = await fetch('/api/data');
  _data = await res.json();
}

// ---------------------------------------------------------------------------
// Minimal markdown renderer
// ---------------------------------------------------------------------------

function renderMarkdown(md) {
  if (!md) return '';

  // Escape HTML
  function esc(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  const lines = md.split('\\n');
  const out = [];
  let inPre = false;
  let preLines = [];
  let inUl = false;

  function closePre() {
    out.push('<pre><code>' + esc(preLines.join('\\n')) + '</code></pre>');
    preLines = [];
    inPre = false;
  }
  function closeUl() {
    out.push('</ul>');
    inUl = false;
  }

  function inlineFormat(s) {
    s = esc(s);
    // Bold
    s = s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    // Inline code
    s = s.replace(/\`([^\`]+)\`/g, '<code>$1</code>');
    // Checkboxes
    s = s.replace(/- \[x\]/gi, '<span class="md-checkbox-done">&#x2611;</span>');
    s = s.replace(/- \[ \]/g, '<span class="md-checkbox-open">&#x2610;</span>');
    return s;
  }

  for (const raw of lines) {
    const line = raw;
    const trimmed = line.trim();

    // Fenced code blocks
    if (trimmed.startsWith('\`\`\`')) {
      if (inPre) { closePre(); continue; }
      if (inUl) closeUl();
      inPre = true;
      continue;
    }
    if (inPre) { preLines.push(line); continue; }

    // Headings
    if (trimmed.startsWith('### ')) {
      if (inUl) closeUl();
      out.push('<h3>' + inlineFormat(trimmed.slice(4)) + '</h3>');
      continue;
    }
    if (trimmed.startsWith('## ')) {
      if (inUl) closeUl();
      out.push('<h2>' + inlineFormat(trimmed.slice(3)) + '</h2>');
      continue;
    }
    if (trimmed.startsWith('# ')) {
      if (inUl) closeUl();
      out.push('<h1>' + inlineFormat(trimmed.slice(2)) + '</h1>');
      continue;
    }

    // List items
    if (/^[-*]\\s/.test(trimmed)) {
      if (!inUl) { out.push('<ul>'); inUl = true; }
      out.push('<li>' + inlineFormat(trimmed.slice(2)) + '</li>');
      continue;
    }

    // Close list on non-list lines
    if (inUl && trimmed !== '') closeUl();

    // Blank line
    if (trimmed === '') {
      if (inUl) closeUl();
      continue;
    }

    out.push('<p>' + inlineFormat(trimmed) + '</p>');
  }

  if (inPre) closePre();
  if (inUl) closeUl();

  return out.join('\\n');
}

// ---------------------------------------------------------------------------
// Render header
// ---------------------------------------------------------------------------

function renderHeader() {
  const p = _data.project;
  document.getElementById('hdr-name').textContent = p.name;
  const branchEl = document.getElementById('hdr-branch');
  if (p.branch) { branchEl.textContent = p.branch; branchEl.style.display = ''; }
  else { branchEl.textContent = '--'; branchEl.style.display = ''; }
  document.getElementById('hdr-path').textContent = p.path;
}

// ---------------------------------------------------------------------------
// Render sidebar
// ---------------------------------------------------------------------------

function renderSidebar() {
  const sb = document.getElementById('sidebar');
  const { progress, features, prd, constraints, project } = _data;

  let html = '';

  // Current section
  if (progress && progress.exists) {
    html += '<div class="sidebar-label">Current</div>';
    const label = progress.currentFeature
      ? (progress.currentFeature + (progress.currentTask ? ' · ' + progress.currentTask : ''))
      : 'In Progress';
    html += sidebarItem('current', label, null, null, progress.currentTask ? true : false);
  }

  // Features
  if (features && features.length > 0) {
    html += '<div class="sidebar-divider"></div>';
    html += '<div class="sidebar-label">Features</div>';
    for (const f of features) {
      const pct = f.totalTasks > 0 ? Math.round((f.doneTasks / f.totalTasks) * 100) : 0;
      const ratio = f.totalTasks > 0 ? (f.doneTasks + '/' + f.totalTasks) : '—';
      html += sidebarItem('feature:' + f.name, f.name, ratio, pct, false);
      html += '<div class="mini-progress"><div class="mini-progress-fill" style="width:' + pct + '%"></div></div>';
    }
  }

  // PRD / Constraints
  const extras = [];
  if (prd && prd.exists) extras.push({ key: 'prd', label: 'PRD' });
  if (constraints && constraints.exists) extras.push({ key: 'constraints', label: 'Constraints' });
  if (extras.length) {
    html += '<div class="sidebar-divider"></div>';
    html += '<div class="sidebar-label">Docs</div>';
    for (const e of extras) html += sidebarItem(e.key, e.label, null, null, false);
  }

  sb.innerHTML = html;

  // Attach click events
  sb.querySelectorAll('.sidebar-item').forEach(el => {
    el.addEventListener('click', () => navigate(el.dataset.key));
  });
}

function sidebarItem(key, label, ratio, pct, isCurrent) {
  return '<div class="sidebar-item" data-key="' + key + '" id="nav-' + key.replace(/:/g,'-') + '">' +
    '<span class="item-label">' + escHtml(label) + '</span>' +
    (ratio ? '<span class="item-ratio">' + ratio + '</span>' : '') +
    (isCurrent ? '<span class="current-badge">active</span>' : '') +
    '</div>';
}

function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// ---------------------------------------------------------------------------
// Navigation
// ---------------------------------------------------------------------------

function navigate(key) {
  _active = key;
  // Update active state in sidebar
  document.querySelectorAll('.sidebar-item').forEach(el => {
    el.classList.toggle('active', el.dataset.key === key);
  });
  renderMain(key);
}

function defaultView() {
  const { progress, features } = _data;
  if (progress && progress.exists) return 'current';
  if (features && features.length > 0) return 'feature:' + features[0].name;
  if (_data.prd && _data.prd.exists) return 'prd';
  if (_data.constraints && _data.constraints.exists) return 'constraints';
  return null;
}

// ---------------------------------------------------------------------------
// Main content rendering
// ---------------------------------------------------------------------------

function renderMain(key) {
  const el = document.getElementById('main');

  if (!_data.project.hasAiDir) {
    el.innerHTML = '<div class="error-state">No <code>ai/</code> directory found at ' +
      escHtml(_data.project.path) +
      '. Run project-kickoff to initialize.</div>';
    return;
  }

  if (key === 'current') {
    el.innerHTML = renderCurrent();
  } else if (key && key.startsWith('feature:')) {
    const name = key.slice(8);
    const feature = _data.features.find(f => f.name === name);
    el.innerHTML = feature ? renderFeature(feature) : '<div class="error-state">Feature not found.</div>';
  } else if (key === 'prd') {
    el.innerHTML = renderDoc('PRD', _data.prd);
  } else if (key === 'constraints') {
    el.innerHTML = renderDoc('Constraints', _data.constraints);
  } else {
    el.innerHTML = '<div class="error-state">Nothing to display.</div>';
  }

  // Bind collapsibles
  el.querySelectorAll('.collapsible-toggle').forEach(toggle => {
    toggle.addEventListener('click', () => {
      const body = toggle.nextElementSibling;
      const arrow = toggle.querySelector('.collapsible-arrow');
      const isOpen = body.classList.toggle('open');
      if (arrow) arrow.textContent = isOpen ? '▼' : '▶';
    });
  });
}

function renderCurrent() {
  const { progress } = _data;
  if (!progress || !progress.exists) return '<div class="error-state">No PROGRESS.md found.</div>';

  let html = '<div class="section-heading">Current Progress</div>';

  // Cards grid
  html += '<div class="progress-cards">';
  if (progress.currentFeature) html += infoCard('Feature', progress.currentFeature, false);
  if (progress.currentTask) {
    const taskLabel = progress.currentTask + (progress.currentTaskName ? ': ' + progress.currentTaskName : '');
    html += infoCard('Task', taskLabel, true);
  }
  if (progress.branch) html += infoCard('Branch', progress.branch, true);
  if (progress.status) html += infoCard('Status', progress.status, false);
  if (progress.blockers) html += infoCard('Blockers', progress.blockers, false);
  html += '</div>';

  // Up next
  if (progress.upNext && progress.upNext.length > 0) {
    html += '<div class="card">';
    html += '<div class="card-label">Up Next</div>';
    html += '<ul class="up-next-list">';
    for (const item of progress.upNext) {
      html += '<li>' + escHtml(item) + '</li>';
    }
    html += '</ul></div>';
  }

  return html;
}

function infoCard(label, value, isCode) {
  return '<div class="card"><div class="card-label">' + escHtml(label) + '</div>' +
    '<div class="card-value' + (isCode ? ' code' : '') + '">' + escHtml(value) + '</div></div>';
}

function renderFeature(feature) {
  const pct = feature.totalTasks > 0 ? Math.round((feature.doneTasks / feature.totalTasks) * 100) : 0;
  let html = '';

  // Header
  html += '<div class="feature-header">';
  html += '<div class="section-heading">' + escHtml(feature.name) + '</div>';
  html += '<div class="feature-progress-bar"><div class="feature-progress-fill" style="width:' + pct + '%"></div></div>';
  html += '<div class="feature-ratio">' + feature.doneTasks + ' / ' + feature.totalTasks + ' tasks done</div>';
  html += '</div>';

  // Requirements collapsible
  if (feature.hasRequirements && feature.requirements) {
    html += '<div class="collapsible-toggle"><span class="collapsible-arrow">▶</span> Requirements</div>';
    html += '<div class="collapsible-body">';
    html += '<div class="card"><div class="md-content">' + renderMarkdown(feature.requirements) + '</div></div>';
    html += '</div>';
  }

  // Tasks
  if (feature.tasks.length === 0) {
    html += '<div class="error-state" style="padding:20px 0;">No tasks found in plan files.</div>';
  } else {
    for (const task of feature.tasks) {
      html += renderTask(task);
    }
  }

  return html;
}

function renderTask(task) {
  const hasBody = task.subtasks.length > 0 || task.keyFiles.length > 0 || task.verification;
  let html = '<div class="task-item">';

  html += '<div class="task-header">';
  html += '<span class="task-id">' + escHtml(task.id) + '</span>';
  html += '<span class="task-title">' + escHtml(task.title) + '</span>';
  html += '<span class="badge ' + (task.done ? 'done' : 'pending') + '">' + (task.done ? 'done' : 'pending') + '</span>';
  html += '</div>';

  if (hasBody) {
    html += '<div class="task-body">';

    if (task.subtasks.length > 0) {
      html += '<div><div class="task-body-label">Subtasks</div><ul class="subtask-list">';
      for (const s of task.subtasks) {
        html += '<li class="subtask-item' + (s.checked ? ' checked-item' : '') + '">';
        html += '<span class="subtask-check' + (s.checked ? ' checked' : '') + '">' + (s.checked ? '✓' : '') + '</span>';
        html += '<span>' + escHtml(s.text) + '</span></li>';
      }
      html += '</ul></div>';
    }

    if (task.keyFiles.length > 0) {
      html += '<div><div class="task-body-label">Key Files</div><ul class="key-files-list">';
      for (const f of task.keyFiles) {
        html += '<li>' + escHtml(f) + '</li>';
      }
      html += '</ul></div>';
    }

    if (task.verification) {
      html += '<div><div class="task-body-label">Verification</div>';
      html += '<div class="verification-block">' + escHtml(task.verification) + '</div></div>';
    }

    html += '</div>';
  }

  html += '</div>';
  return html;
}

function renderDoc(title, doc) {
  if (!doc || !doc.exists) return '<div class="error-state">' + escHtml(title) + ' not found.</div>';
  return '<div class="section-heading">' + escHtml(title) + '</div>' +
    '<div class="card"><div class="md-content">' + renderMarkdown(doc.raw) + '</div></div>';
}

// ---------------------------------------------------------------------------
// Init
// ---------------------------------------------------------------------------

async function init() {
  try {
    await fetchData();
    renderHeader();
    renderSidebar();
    const view = defaultView();
    if (view) navigate(view);
    else document.getElementById('main').innerHTML = '<div class="error-state">No content available.</div>';
  } catch (err) {
    document.getElementById('main').innerHTML =
      '<div class="error-state">Failed to load data: ' + escHtml(String(err)) + '</div>';
  }
}

init();
</script>
</body>
</html>`;
}

// ---------------------------------------------------------------------------
// Port finding
// ---------------------------------------------------------------------------

function findAvailablePort(start, end) {
  return new Promise((resolve, reject) => {
    let port = start;

    function tryPort() {
      if (port > end) {
        reject(new Error(`Error: No available port found between ${start} and ${end}.`));
        return;
      }
      const server = http.createServer();
      server.listen(port, '127.0.0.1', () => {
        server.close(() => resolve(port));
      });
      server.on('error', () => {
        port++;
        tryPort();
      });
    }

    tryPort();
  });
}

// ---------------------------------------------------------------------------
// HTTP server
// ---------------------------------------------------------------------------

function startServer(projectRoot, port) {
  const html = buildHtml();

  const server = http.createServer((req, res) => {
    if (req.method !== 'GET') {
      res.writeHead(405);
      res.end();
      return;
    }

    if (req.url === '/') {
      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
      res.end(html);
      return;
    }

    if (req.url === '/api/data') {
      try {
        const data = buildData(projectRoot);
        res.writeHead(200, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify(data));
      } catch (err) {
        res.writeHead(500, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ error: String(err) }));
      }
      return;
    }

    res.writeHead(404);
    res.end();
  });

  server.listen(port, '127.0.0.1', () => {
    const projectName = path.basename(projectRoot);
    console.log(`ai-monitor v${VERSION}`);
    console.log(`Project: ${projectName} (${projectRoot})`);
    console.log(`Dashboard: http://localhost:${port}`);
    console.log(`Press Ctrl+C to stop.`);

    // Open browser
    const url = `http://localhost:${port}`;
    try {
      if (process.platform === 'darwin') {
        execSync(`open "${url}"`, { stdio: 'ignore' });
      } else {
        execSync(`xdg-open "${url}"`, { stdio: 'ignore' });
      }
    } catch {
      // Browser open failed — not fatal
    }
  });

  process.on('SIGINT', () => {
    server.close(() => process.exit(0));
  });
  process.on('SIGTERM', () => {
    server.close(() => process.exit(0));
  });
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

async function main() {
  const projectRoot = resolveProjectRoot();
  const aiDir = path.join(projectRoot, 'ai');

  if (!fs.existsSync(aiDir) && !process.argv[2]) {
    console.error(`Error: No path provided and current directory has no ai/ directory.`);
    process.exit(1);
  }

  let port;
  try {
    port = await findAvailablePort(PORT_START, PORT_END);
  } catch (err) {
    console.error(err.message);
    process.exit(1);
  }

  startServer(projectRoot, port);
}

main();
