#!/usr/bin/env node

'use strict';

const http = require('http');
const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const VERSION = '1.0.0';
const PORT_START = 4242;
const PORT_END = 4250;

// ---------------------------------------------------------------------------
// Path resolution
// ---------------------------------------------------------------------------

function resolveProjectRoot() {
  const arg = process.argv[2];
  if (arg) {
    const resolved = path.resolve(arg);
    if (!fs.existsSync(resolved)) {
      console.error('Error: Path "' + resolved + '" does not exist.');
      process.exit(1);
    }
    return resolved;
  }
  return process.cwd();
}

// ---------------------------------------------------------------------------
// Git branch
// ---------------------------------------------------------------------------

function getGitBranch(projectRoot) {
  try {
    return execSync('git -C "' + projectRoot + '" rev-parse --abbrev-ref HEAD', {
      stdio: ['ignore', 'pipe', 'ignore']
    }).toString().trim();
  } catch (_) {
    return null;
  }
}

// ---------------------------------------------------------------------------
// File reading helpers
// ---------------------------------------------------------------------------

function readFileSafe(filePath) {
  try {
    return fs.readFileSync(filePath, 'utf8');
  } catch (_) {
    return null;
  }
}

// ---------------------------------------------------------------------------
// PROGRESS.md parsing
// ---------------------------------------------------------------------------

function parseProgress(raw) {
  if (!raw) return { exists: false };

  var result = {
    exists: true,
    currentFeature: null,
    currentTask: null,
    currentTaskName: null,
    branch: null,
    status: null,
    blockers: null,
    upNext: [],
    raw: raw
  };

  var lines = raw.split('\n');
  var inUpNext = false;

  for (var i = 0; i < lines.length; i++) {
    // Fields may appear bare (**Feature**: x) or as list items (- **Feature**: x)
    var t = lines[i].trim().replace(/^[-*]\s+(?=\*\*)/, '');

    if (/^\*\*Feature\*\*:/.test(t)) {
      result.currentFeature = t.replace(/^\*\*Feature\*\*:\s*/, '').trim();
      inUpNext = false;
    } else if (/^\*\*Task\*\*:/.test(t)) {
      var rv = t.replace(/^\*\*Task\*\*:\s*/, '').trim();
      var m = rv.match(/^([\d.]+)\s*(?:\(([^)]+)\))?/);
      if (m) { result.currentTask = m[1] || null; result.currentTaskName = m[2] || null; }
      inUpNext = false;
    } else if (/^\*\*Branch\*\*:/.test(t)) {
      result.branch = t.replace(/^\*\*Branch\*\*:\s*/, '').trim();
      inUpNext = false;
    } else if (/^\*\*Status\*\*:/.test(t)) {
      result.status = t.replace(/^\*\*Status\*\*:\s*/, '').trim();
      inUpNext = false;
    } else if (/^\*\*Blockers?\*\*:/.test(t)) {
      result.blockers = t.replace(/^\*\*Blockers?\*\*:\s*/, '').trim();
      inUpNext = false;
    } else if (/^##\s+Up Next/.test(t)) {
      inUpNext = true;
    } else if (inUpNext) {
      if (/^##/.test(t)) { inUpNext = false; }
      else if (/^[-*]\s+/.test(t)) { result.upNext.push(t.replace(/^[-*]\s+/, '').trim()); }
    }
  }

  return result;
}

// ---------------------------------------------------------------------------
// Plan file parsing
// ---------------------------------------------------------------------------

function parsePlanFile(raw, sourceFile) {
  if (!raw) return [];

  var tasks = [];
  var lines = raw.split('\n');
  var current = null;
  var section = null;

  function pushCurrent() {
    if (current) tasks.push(current);
    current = null;
    section = null;
  }

  for (var i = 0; i < lines.length; i++) {
    var t = lines[i].trim();

    var tm = t.match(/^##\s+Task\s+([\d.]+):\s+(.+?)(\s+\[DONE\])?$/i);
    if (tm) {
      pushCurrent();
      current = {
        id: tm[1],
        title: tm[2].replace(/\[DONE\]/i, '').trim(),
        done: !!tm[3],
        subtasks: [],
        keyFiles: [],
        verification: null,
        sourceFile: sourceFile
      };
      section = null;
      continue;
    }

    if (!current) continue;

    if (/^###\s+Subtasks?/i.test(t))    { section = 'subtasks'; continue; }
    if (/^###\s+Key\s+Files?/i.test(t)) { section = 'keyfiles'; continue; }
    if (/^###\s+Verification/i.test(t)) { section = 'verification'; continue; }
    if (/^###/.test(t))                  { section = null; continue; }

    if (section === 'subtasks') {
      var ck = /^-\s+\[x\]/i.test(t);
      var un = /^-\s+\[ \]/.test(t);
      if (ck || un) {
        current.subtasks.push({ text: t.replace(/^-\s+\[[x ]\]\s*/i, '').trim(), checked: ck });
      }
    } else if (section === 'keyfiles') {
      if (/^[-*]\s+/.test(t)) { current.keyFiles.push(t.replace(/^[-*]\s+/, '').trim()); }
    } else if (section === 'verification') {
      if (t && !/^###/.test(t)) {
        current.verification = (current.verification ? current.verification + '\n' : '') + t;
      }
    }
  }

  pushCurrent();
  return tasks;
}

// ---------------------------------------------------------------------------
// Feature directory parsing
// ---------------------------------------------------------------------------

function parseFeature(featureDir, featureName) {
  var entries = fs.readdirSync(featureDir).sort();
  var planFiles = entries.filter(function(e) { return e !== 'requirements.md' && e.endsWith('.md'); });
  var hasRequirements = entries.indexOf('requirements.md') !== -1;
  var requirements = hasRequirements ? readFileSafe(path.join(featureDir, 'requirements.md')) : null;

  var allTasks = [];
  for (var i = 0; i < planFiles.length; i++) {
    var raw = readFileSafe(path.join(featureDir, planFiles[i]));
    if (raw) {
      var tasks = parsePlanFile(raw, planFiles[i]);
      allTasks = allTasks.concat(tasks);
    }
  }

  var doneTasks = allTasks.filter(function(t) { return t.done; }).length;

  return {
    name: featureName,
    hasRequirements: hasRequirements,
    requirements: requirements,
    totalTasks: allTasks.length,
    doneTasks: doneTasks,
    tasks: allTasks
  };
}

// ---------------------------------------------------------------------------
// API data builder
// ---------------------------------------------------------------------------

function buildData(projectRoot) {
  var projectName = path.basename(projectRoot);
  var branch = getGitBranch(projectRoot);
  var aiDir = path.join(projectRoot, 'ai');
  var hasAiDir = fs.existsSync(aiDir);

  var project = { name: projectName, path: projectRoot, branch: branch, hasAiDir: hasAiDir };

  if (!hasAiDir) {
    return { project: project, progress: { exists: false }, constraints: { exists: false }, prd: { exists: false }, features: [] };
  }

  var progressRaw = readFileSafe(path.join(aiDir, 'PROGRESS.md'));
  var constraintsRaw = readFileSafe(path.join(aiDir, 'CONSTRAINTS.md'));
  var prdRaw = readFileSafe(path.join(aiDir, 'PRD.md'));

  var progress = parseProgress(progressRaw);
  var constraints = constraintsRaw ? { exists: true, raw: constraintsRaw } : { exists: false };
  var prd = prdRaw ? { exists: true, raw: prdRaw } : { exists: false };

  var plansDir = path.join(aiDir, 'plans');
  var features = [];
  if (fs.existsSync(plansDir)) {
    var featureDirs = fs.readdirSync(plansDir)
      .filter(function(e) { return fs.statSync(path.join(plansDir, e)).isDirectory(); })
      .sort();
    features = featureDirs.map(function(name) {
      return parseFeature(path.join(plansDir, name), name);
    });
  }

  return { project: project, progress: progress, constraints: constraints, prd: prd, features: features };
}

