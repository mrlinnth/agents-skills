#!/usr/bin/env node

'use strict';

const http = require('http');
const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const VERSION = '1.0.0';
const PORT_START = 4242;
const PORT_END = 4250;

// ---------------------------------------------------------------------------
// Path resolution
// ---------------------------------------------------------------------------

function resolveProjectRoot() {
  const arg = process.argv[2];
  if (arg) {
    const resolved = path.resolve(arg);
    if (!fs.existsSync(resolved)) {
      console.error(`Error: Path "${resolved}" does not exist.`);
      process.exit(1);
    }
    return resolved;
  }
  return process.cwd();
}

// ---------------------------------------------------------------------------
// Git branch
// ---------------------------------------------------------------------------

function getGitBranch(projectRoot) {
  try {
    return execSync(`git -C "${projectRoot}" rev-parse --abbrev-ref HEAD`, {
      stdio: ['ignore', 'pipe', 'ignore']
    }).toString().trim();
  } catch {
    return null;
  }
}

// ---------------------------------------------------------------------------
// File reading helpers
// ---------------------------------------------------------------------------

function readFileSafe(filePath) {
  try {
    return fs.readFileSync(filePath, 'utf8');
  } catch {
    return null;
  }
}

// ---------------------------------------------------------------------------
// PROGRESS.md parsing
// ---------------------------------------------------------------------------

function parseProgress(raw) {
  if (!raw) return { exists: false };

  const result = {
    exists: true,
    currentFeature: null,
    currentTask: null,
    currentTaskName: null,
    branch: null,
    status: null,
    blockers: null,
    upNext: [],
    raw
  };

  const lines = raw.split('\n');
  let inUpNext = false;

  for (const line of lines) {
    const trimmed = line.trim();

    if (/^\*\*Feature\*\*:/.test(trimmed)) {
      result.currentFeature = trimmed.replace(/^\*\*Feature\*\*:\s*/, '').trim();
      inUpNext = false;
    } else if (/^\*\*Task\*\*:/.test(trimmed)) {
      const raw = trimmed.replace(/^\*\*Task\*\*:\s*/, '').trim();
      // e.g. "2.3 (Token Management)" or "2.3"
      const m = raw.match(/^([\d.]+)\s*(?:\(([^)]+)\))?/);
      if (m) {
        result.currentTask = m[1] || null;
        result.currentTaskName = m[2] || null;
      }
      inUpNext = false;
    } else if (/^\*\*Branch\*\*:/.test(trimmed)) {
      result.branch = trimmed.replace(/^\*\*Branch\*\*:\s*/, '').trim();
      inUpNext = false;
    } else if (/^\*\*Status\*\*:/.test(trimmed)) {
      result.status = trimmed.replace(/^\*\*Status\*\*:\s*/, '').trim();
      inUpNext = false;
    } else if (/^\*\*Blockers?\*\*:/.test(trimmed)) {
      result.blockers = trimmed.replace(/^\*\*Blockers?\*\*:\s*/, '').trim();
      inUpNext = false;
    } else if (/^##\s+Up Next/.test(trimmed)) {
      inUpNext = true;
    } else if (inUpNext) {
      if (/^##/.test(trimmed)) {
        inUpNext = false;
      } else if (/^[-*]\s+/.test(trimmed)) {
        result.upNext.push(trimmed.replace(/^[-*]\s+/, '').trim());
      }
    }
  }

  return result;
}

// ---------------------------------------------------------------------------
// Plan file parsing
// ---------------------------------------------------------------------------

function parsePlanFile(raw, sourceFile) {
  if (!raw) return [];

  const tasks = [];
  const lines = raw.split('\n');
  let current = null;
  let section = null;

  function pushCurrent() {
    if (current) tasks.push(current);
    current = null;
    section = null;
  }

  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    const trimmed = line.trim();

    // Task heading: ## Task 1.1: Title or ## Task 1.1: Title [DONE]
    const taskMatch = trimmed.match(/^##\s+Task\s+([\d.]+):\s+(.+?)(\s+\[DONE\])?$/i);
    if (taskMatch) {
      pushCurrent();
      const done = !!taskMatch[3];
      const title = taskMatch[2].replace(/\[DONE\]/i, '').trim();
      current = {
        id: taskMatch[1],
        title,
        done,
        subtasks: [],
        keyFiles: [],
        verification: null,
        sourceFile
      };
      section = null;
      continue;
    }

    if (!current) continue;

    // Section headings
    if (/^###\s+Subtasks?/i.test(trimmed)) { section = 'subtasks'; continue; }
    if (/^###\s+Key\s+Files?/i.test(trimmed)) { section = 'keyfiles'; continue; }
    if (/^###\s+Verification/i.test(trimmed)) { section = 'verification'; continue; }
    if (/^###/.test(trimmed)) { section = null; continue; }

    if (section === 'subtasks') {
      const checked = /^-\s+\[x\]/i.test(trimmed);
      const unchecked = /^-\s+\[ \]/.test(trimmed);
      if (checked || unchecked) {
        const text = trimmed.replace(/^-\s+\[[x ]\]\s*/i, '').trim();
        current.subtasks.push({ text, checked });
      }
    } else if (section === 'keyfiles') {
      if (/^[-*]\s+/.test(trimmed)) {
        current.keyFiles.push(trimmed.replace(/^[-*]\s+/, '').trim());
      }
    } else if (section === 'verification') {
      if (trimmed && !/^###/.test(trimmed)) {
        current.verification = (current.verification ? current.verification + '\n' : '') + trimmed;
      }
    }
  }

  pushCurrent();
  return tasks;
}

// ---------------------------------------------------------------------------
// Feature directory parsing
// ---------------------------------------------------------------------------

function parseFeature(featureDir, featureName) {
  const entries = fs.readdirSync(featureDir).sort();
  const planFiles = entries.filter(e => e !== 'requirements.md' && e.endsWith('.md'));
  const hasRequirements = entries.includes('requirements.md');
  const requirements = hasRequirements
    ? readFileSafe(path.join(featureDir, 'requirements.md'))
    : null;

  const allTasks = [];
  for (const file of planFiles) {
    const raw = readFileSafe(path.join(featureDir, file));
    if (raw) {
      const tasks = parsePlanFile(raw, file);
      allTasks.push(...tasks);
    }
  }

  const doneTasks = allTasks.filter(t => t.done).length;

  return {
    name: featureName,
    hasRequirements,
    requirements,
    totalTasks: allTasks.length,
    doneTasks,
    tasks: allTasks
  };
}

// ---------------------------------------------------------------------------
// API data builder
// ---------------------------------------------------------------------------

function buildData(projectRoot) {
  const projectName = path.basename(projectRoot);
  const branch = getGitBranch(projectRoot);
  const aiDir = path.join(projectRoot, 'ai');
  const hasAiDir = fs.existsSync(aiDir);

  const project = { name: projectName, path: projectRoot, branch, hasAiDir };

  if (!hasAiDir) {
    return { project, progress: { exists: false }, constraints: { exists: false }, prd: { exists: false }, features: [] };
  }

  // Core files
  const progressRaw = readFileSafe(path.join(aiDir, 'PROGRESS.md'));
  const constraintsRaw = readFileSafe(path.join(aiDir, 'CONSTRAINTS.md'));
  const prdRaw = readFileSafe(path.join(aiDir, 'PRD.md'));

  const progress = parseProgress(progressRaw);
  const constraints = constraintsRaw
    ? { exists: true, raw: constraintsRaw }
    : { exists: false };
  const prd = prdRaw
    ? { exists: true, raw: prdRaw }
    : { exists: false };

  // Features
  const plansDir = path.join(aiDir, 'plans');
  let features = [];
  if (fs.existsSync(plansDir)) {
    const featureDirs = fs.readdirSync(plansDir)
      .filter(e => fs.statSync(path.join(plansDir, e)).isDirectory())
      .sort();
    features = featureDirs.map(name => parseFeature(path.join(plansDir, name), name));
  }

  return { project, progress, constraints, prd, features };
}

