// The client-side JS is a plain string — no escaping tricks needed since
// this content is written via fs / http, not embedded in a template literal.
var DASHBOARD_JS = [
'var _data = null;',
'var _active = null;',
'var _lastJson = null;',
'',
'// Returns true when the data changed since the last fetch.',
'async function fetchData() {',
'  var res = await fetch("/api/data");',
'  var text = await res.text();',
'  var changed = text !== _lastJson;',
'  if (changed) { _lastJson = text; _data = JSON.parse(text); }',
'  return changed;',
'}',
'',
'function esc(s) {',
'  return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/\'/g,"&#39;");',
'}',
'',
'function renderMarkdown(md) {',
'  if (!md) return "";',
'  var lines = md.split("\\n");',
'  var out = [];',
'  var inPre = false;',
'  var preLines = [];',
'  var inUl = false;',
'',
'  function closePre() {',
'    out.push("<pre><code>" + esc(preLines.join("\\n")) + "</code></pre>");',
'    preLines = []; inPre = false;',
'  }',
'  function closeUl() { out.push("</ul>"); inUl = false; }',
'',
'  function fmt(s) {',
'    s = esc(s);',
'    s = s.replace(/\\*\\*(.+?)\\*\\*/g, "<strong>$1</strong>");',
'    s = s.replace(/`([^`]+)`/g, "<code>$1</code>");',
'    s = s.replace(/- \\[x\\]/gi, "<span class=\\"md-checkbox-done\\">&#x2611;</span>");',
'    s = s.replace(/- \\[ \\]/g, "<span class=\\"md-checkbox-open\\">&#x2610;</span>");',
'    return s;',
'  }',
'',
'  for (var i = 0; i < lines.length; i++) {',
'    var line = lines[i];',
'    var t = line.trim();',
'    if (t.slice(0,3) === "```") {',
'      if (inPre) { closePre(); continue; }',
'      if (inUl) closeUl();',
'      inPre = true; continue;',
'    }',
'    if (inPre) { preLines.push(line); continue; }',
'    if (t.slice(0,4) === "### ") { if (inUl) closeUl(); out.push("<h3>" + fmt(t.slice(4)) + "</h3>"); continue; }',
'    if (t.slice(0,3) === "## ") { if (inUl) closeUl(); out.push("<h2>" + fmt(t.slice(3)) + "</h2>"); continue; }',
'    if (t.slice(0,2) === "# ") { if (inUl) closeUl(); out.push("<h1>" + fmt(t.slice(2)) + "</h1>"); continue; }',
'    if (t.length > 1 && (t[0] === "-" || t[0] === "*") && t[1] === " ") {',
'      if (!inUl) { out.push("<ul>"); inUl = true; }',
'      out.push("<li>" + fmt(t.slice(2)) + "</li>"); continue;',
'    }',
'    if (inUl && t !== "") closeUl();',
'    if (t === "") { if (inUl) closeUl(); continue; }',
'    out.push("<p>" + fmt(t) + "</p>");',
'  }',
'  if (inPre) closePre();',
'  if (inUl) closeUl();',
'  return out.join("\\n");',
'}',
'',
'function renderHeader() {',
'  var p = _data.project;',
'  document.getElementById("hdr-name").textContent = p.name;',
'  document.getElementById("hdr-branch").textContent = p.branch || "--";',
'  document.getElementById("hdr-path").textContent = p.path;',
'}',
'',
'function renderSidebar() {',
'  var sb = document.getElementById("sidebar");',
'  var progress = _data.progress, features = _data.features, prd = _data.prd, constraints = _data.constraints;',
'  var html = "";',
'  if (progress && progress.exists) {',
'    html += "<div class=\\"sidebar-label\\">Current</div>";',
'    var label = progress.currentFeature',
'      ? (progress.currentFeature + (progress.currentTask ? " \xB7 " + progress.currentTask : ""))',
'      : "In Progress";',
'    html += sidebarItem("current", label, null, false, !!progress.currentTask);',
'  }',
'  if (features && features.length > 0) {',
'    html += "<div class=\\"sidebar-divider\\"></div><div class=\\"sidebar-label\\">Features</div>";',
'    for (var i = 0; i < features.length; i++) {',
'      var f = features[i];',
'      var pct = f.totalTasks > 0 ? Math.round((f.doneTasks / f.totalTasks) * 100) : 0;',
'      var ratio = f.totalTasks > 0 ? (f.doneTasks + "/" + f.totalTasks) : "\u2014";',
'      html += sidebarItem("feature:" + f.name, f.name, ratio, false, false);',
'      html += "<div class=\\"mini-progress\\"><div class=\\"mini-progress-fill\\" style=\\"width:" + pct + "%\\"></div></div>";',
'    }',
'  }',
'  var extras = [];',
'  if (prd && prd.exists) extras.push({ key: "prd", label: "PRD" });',
'  if (constraints && constraints.exists) extras.push({ key: "constraints", label: "Constraints" });',
'  if (extras.length) {',
'    html += "<div class=\\"sidebar-divider\\"></div><div class=\\"sidebar-label\\">Docs</div>";',
'    for (var j = 0; j < extras.length; j++) html += sidebarItem(extras[j].key, extras[j].label, null, false, false);',
'  }',
'  sb.innerHTML = html;',
'  var items = sb.querySelectorAll(".sidebar-item");',
'  for (var k = 0; k < items.length; k++) {',
'    items[k].addEventListener("click", (function(key) { return function() { navigate(key); }; })(items[k].dataset.key));',
'  }',
'}',
'',
'function sidebarItem(key, label, ratio, _pct, isCurrent) {',
'  return "<div class=\\"sidebar-item\\" data-key=\\"" + esc(key) + "\\">" +',
'    "<span class=\\"item-label\\">" + esc(label) + "</span>" +',
'    (ratio ? "<span class=\\"item-ratio\\">" + esc(ratio) + "</span>" : "") +',
'    (isCurrent ? "<span class=\\"current-badge\\">active</span>" : "") +',
'    "</div>";',
'}',
'',
'function navigate(key) {',
'  _active = key;',
'  var items = document.querySelectorAll(".sidebar-item");',
'  for (var i = 0; i < items.length; i++) {',
'    items[i].classList.toggle("active", items[i].dataset.key === key);',
'  }',
'  renderMain(key);',
'}',
'',
'function defaultView() {',
'  if (_data.progress && _data.progress.exists) return "current";',
'  if (_data.features && _data.features.length > 0) return "feature:" + _data.features[0].name;',
'  if (_data.prd && _data.prd.exists) return "prd";',
'  if (_data.constraints && _data.constraints.exists) return "constraints";',
'  return null;',
'}',
'',
'function renderMain(key) {',
'  var el = document.getElementById("main");',
'  if (!_data.project.hasAiDir) {',
'    el.innerHTML = "<div class=\\"error-state\\">No <code>ai/</code> directory found at " + esc(_data.project.path) + ". Run project-kickoff to initialize.</div>";',
'    return;',
'  }',
'  if (key === "current") { el.innerHTML = renderCurrent(); }',
'  else if (key && key.slice(0,8) === "feature:") {',
'    var name = key.slice(8);',
'    var feature = null;',
'    for (var i = 0; i < _data.features.length; i++) { if (_data.features[i].name === name) { feature = _data.features[i]; break; } }',
'    el.innerHTML = feature ? renderFeature(feature) : "<div class=\\"error-state\\">Feature not found.</div>";',
'  } else if (key === "prd") {',
'    el.innerHTML = renderDoc("PRD", _data.prd);',
'  } else if (key === "constraints") {',
'    el.innerHTML = renderDoc("Constraints", _data.constraints);',
'  } else {',
'    el.innerHTML = "<div class=\\"error-state\\">Nothing to display.</div>";',
'  }',
'  var toggles = el.querySelectorAll(".collapsible-toggle");',
'  for (var j = 0; j < toggles.length; j++) {',
'    toggles[j].addEventListener("click", (function(tog) {',
'      return function() {',
'        var body = tog.nextElementSibling;',
'        var arrow = tog.querySelector(".collapsible-arrow");',
'        var isOpen = body.classList.toggle("open");',
'        if (arrow) arrow.textContent = isOpen ? "\u25BC" : "\u25B6";',
'      };',
'    })(toggles[j]));',
'  }',
'}',
'',
'function renderCurrent() {',
'  var progress = _data.progress;',
'  if (!progress || !progress.exists) return "<div class=\\"error-state\\">No PROGRESS.md found.</div>";',
'  var html = "<div class=\\"section-heading\\">Current Progress</div><div class=\\"progress-cards\\">";',
'  if (progress.currentFeature) html += infoCard("Feature", progress.currentFeature, false);',
'  if (progress.currentTask) {',
'    var tl = progress.currentTask + (progress.currentTaskName ? ": " + progress.currentTaskName : "");',
'    html += infoCard("Task", tl, true);',
'  }',
'  if (progress.branch) html += infoCard("Branch", progress.branch, true);',
'  if (progress.status) html += infoCard("Status", progress.status, false);',
'  if (progress.blockers) html += infoCard("Blockers", progress.blockers, false);',
'  html += "</div>";',
'  if (progress.upNext && progress.upNext.length > 0) {',
'    html += "<div class=\\"card\\"><div class=\\"card-label\\">Up Next</div><ul class=\\"up-next-list\\">";',
'    for (var i = 0; i < progress.upNext.length; i++) html += "<li>" + esc(progress.upNext[i]) + "</li>";',
'    html += "</ul></div>";',
'  }',
'  return html;',
'}',
'',
'function infoCard(label, value, isCode) {',
'  return "<div class=\\"card\\"><div class=\\"card-label\\">" + esc(label) + "</div>" +',
'    "<div class=\\"card-value" + (isCode ? " code" : "") + "\\">" + esc(value) + "</div></div>";',
'}',
'',
'function renderFeature(feature) {',
'  var pct = feature.totalTasks > 0 ? Math.round((feature.doneTasks / feature.totalTasks) * 100) : 0;',
'  var html = "<div class=\\"feature-header\\">" +',
'    "<div class=\\"section-heading\\">" + esc(feature.name) + "</div>" +',
'    "<div class=\\"feature-progress-bar\\"><div class=\\"feature-progress-fill\\" style=\\"width:" + pct + "%\\"></div></div>" +',
'    "<div class=\\"feature-ratio\\">" + feature.doneTasks + " / " + feature.totalTasks + " tasks done</div>" +',
'    "</div>";',
'  if (feature.hasRequirements && feature.requirements) {',
'    html += "<div class=\\"collapsible-toggle\\"><span class=\\"collapsible-arrow\\">\u25B6</span> Requirements</div>" +',
'      "<div class=\\"collapsible-body\\"><div class=\\"card\\"><div class=\\"md-content\\">" + renderMarkdown(feature.requirements) + "</div></div></div>";',
'  }',
'  if (feature.tasks.length === 0) {',
'    html += "<div class=\\"error-state\\" style=\\"padding:20px 0;\\">No tasks found in plan files.</div>";',
'  } else {',
'    for (var i = 0; i < feature.tasks.length; i++) html += renderTask(feature.tasks[i]);',
'  }',
'  return html;',
'}',
'',
'function renderTask(task) {',
'  var hasBody = task.subtasks.length > 0 || task.keyFiles.length > 0 || task.verification;',
'  var html = "<div class=\\"task-item\\">" +',
'    "<div class=\\"task-header\\">" +',
'    "<span class=\\"task-id\\">" + esc(task.id) + "</span>" +',
'    "<span class=\\"task-title\\">" + esc(task.title) + "</span>" +',
'    "<span class=\\"badge " + (task.done ? "done" : "pending") + "\\">" + (task.done ? "done" : "pending") + "</span>" +',
'    "</div>";',
'  if (hasBody) {',
'    html += "<div class=\\"task-body\\">";',
'    if (task.subtasks.length > 0) {',
'      html += "<div><div class=\\"task-body-label\\">Subtasks</div><ul class=\\"subtask-list\\">";',
'      for (var i = 0; i < task.subtasks.length; i++) {',
'        var s = task.subtasks[i];',
'        html += "<li class=\\"subtask-item" + (s.checked ? " checked-item" : "") + "\\">" +',
'          "<span class=\\"subtask-check" + (s.checked ? " checked" : "") + "\\">" + (s.checked ? "\u2713" : "") + "</span>" +',
'          "<span>" + esc(s.text) + "</span></li>";',
'      }',
'      html += "</ul></div>";',
'    }',
'    if (task.keyFiles.length > 0) {',
'      html += "<div><div class=\\"task-body-label\\">Key Files</div><ul class=\\"key-files-list\\">";',
'      for (var j = 0; j < task.keyFiles.length; j++) html += "<li>" + esc(task.keyFiles[j]) + "</li>";',
'      html += "</ul></div>";',
'    }',
'    if (task.verification) {',
'      html += "<div><div class=\\"task-body-label\\">Verification</div><div class=\\"verification-block\\">" + esc(task.verification) + "</div></div>";',
'    }',
'    html += "</div>";',
'  }',
'  html += "</div>";',
'  return html;',
'}',
'',
'function renderDoc(title, doc) {',
'  if (!doc || !doc.exists) return "<div class=\\"error-state\\">" + esc(title) + " not found.</div>";',
'  return "<div class=\\"section-heading\\">" + esc(title) + "</div>" +',
'    "<div class=\\"card\\"><div class=\\"md-content\\">" + renderMarkdown(doc.raw) + "</div></div>";',
'}',
'',
'async function refresh() {',
'  var changed = await fetchData();',
'  if (!changed) return;',
'  renderHeader();',
'  renderSidebar();',
'  var view = _active || defaultView();',
'  if (view && view.slice(0,8) === "feature:") {',
'    var name = view.slice(8);',
'    var found = false;',
'    for (var i = 0; i < _data.features.length; i++) { if (_data.features[i].name === name) { found = true; break; } }',
'    if (!found) view = defaultView();',
'  }',
'  if (view) navigate(view);',
'  else document.getElementById("main").innerHTML = "<div class=\\"error-state\\">No content available.</div>";',
'}',
'',
'async function init() {',
'  try {',
'    await refresh();',
'  } catch (err) {',
'    document.getElementById("main").innerHTML = "<div class=\\"error-state\\">Failed to load data: " + esc(String(err)) + "</div>";',
'  }',
'  setInterval(function() { refresh().catch(function() {}); }, 5000);',
'}',
'',
'init();'
].join('\n');

var DASHBOARD_HTML_CLOSE = '\n</script>\n</body>\n</html>';

var DASHBOARD_HTML = DASHBOARD_HTML_OPEN + DASHBOARD_JS + DASHBOARD_HTML_CLOSE;

// ---------------------------------------------------------------------------
// Port finding
// ---------------------------------------------------------------------------

function findAvailablePort(start, end) {
  return new Promise(function(resolve, reject) {
    var port = start;
    function tryPort() {
      if (port > end) {
        reject(new Error('Error: No available port found between ' + start + ' and ' + end + '.'));
        return;
      }
      var server = http.createServer();
      server.listen(port, '127.0.0.1', function() {
        server.close(function() { resolve(port); });
      });
      server.on('error', function() { port++; tryPort(); });
    }
    tryPort();
  });
}

// ---------------------------------------------------------------------------
// HTTP server
// ---------------------------------------------------------------------------

function startServer(projectRoot, port) {
  var server = http.createServer(function(req, res) {
    if (req.method !== 'GET') { res.writeHead(405); res.end(); return; }

    if (req.url === '/') {
      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
      res.end(DASHBOARD_HTML);
      return;
    }

    if (req.url === '/api/data') {
      try {
        var data = buildData(projectRoot);
        res.writeHead(200, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify(data));
      } catch (err) {
        res.writeHead(500, { 'Content-Type': 'application/json' });
        res.end(JSON.stringify({ error: String(err) }));
      }
      return;
    }

    res.writeHead(404);
    res.end();
  });

  server.listen(port, '127.0.0.1', function() {
    var projectName = path.basename(projectRoot);
    console.log('ai-monitor v' + VERSION);
    console.log('Project: ' + projectName + ' (' + projectRoot + ')');
    console.log('Dashboard: http://localhost:' + port);
    console.log('Press Ctrl+C to stop.');

    var url = 'http://localhost:' + port;
    try {
      if (process.platform === 'darwin') { execSync('open "' + url + '"', { stdio: 'ignore' }); }
      else { execSync('xdg-open "' + url + '"', { stdio: 'ignore' }); }
    } catch (_) {}
  });

  process.on('SIGINT', function() { server.close(function() { process.exit(0); }); });
  process.on('SIGTERM', function() { server.close(function() { process.exit(0); }); });
}

// ---------------------------------------------------------------------------
// Entry point
// ---------------------------------------------------------------------------

async function main() {
  var projectRoot = resolveProjectRoot();
  var aiDir = path.join(projectRoot, 'ai');

  if (!fs.existsSync(aiDir) && !process.argv[2]) {
    console.error('Error: No path provided and current directory has no ai/ directory.');
    process.exit(1);
  }

  var port;
  try {
    port = await findAvailablePort(PORT_START, PORT_END);
  } catch (err) {
    console.error(err.message);
    process.exit(1);
  }

  startServer(projectRoot, port);
}

main();
